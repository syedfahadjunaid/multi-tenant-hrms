# Copy this file to .env (which is git-ignored):
#   Copy-Item .env.example .env
#
# These are LOCAL DEVELOPMENT values only. Never reuse them anywhere real.
# Both services also read ../../.env when you run them from your IDE.

POSTGRES_SUPERUSER_PASSWORD=dev-postgres-superuser
CORE_DB_PASSWORD=dev-core-svc
AI_DB_PASSWORD=dev-ai-svc
KEYCLOAK_DB_PASSWORD=dev-keycloak-db
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin
REDIS_PASSWORD=dev-redis
# The BFF's client secret in Keycloak (imported into the realm on Keycloak's first start)
BFF_CLIENT_SECRET=dev-bff-client-secret

# Host ports (non-standard so they don't clash with other local Postgres/Redis instances)
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379

# Optional: keyword + vector (hybrid) search. Off by default; see the README for why.
RETRIEVAL_HYBRID=false

# Optional: set this to get real LLM answers from Claude.
# Left empty, the AI service runs in offline mode and returns the best-matching passages.
ANTHROPIC_API_KEY=
