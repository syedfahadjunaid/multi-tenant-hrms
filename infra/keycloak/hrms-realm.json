{
  "realm": "hrms",
  "displayName": "HRMS (local development)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": false,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "roles": {
    "realm": [
      { "name": "HR_ADMIN", "description": "Manages employees and HR policy documents for their tenant" },
      { "name": "MANAGER", "description": "Views employees in their tenant" },
      { "name": "EMPLOYEE", "description": "Regular employee" }
    ]
  },
  "clients": [
    {
      "clientId": "hrms-bff",
      "name": "HRMS backend-for-frontend (confidential client, authorization code + PKCE)",
      "description": "The browser only gets an HttpOnly session cookie; the BFF keeps the tokens. The secret comes from BFF_CLIENT_SECRET in .env when the realm is imported.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5280/login/oauth2/code/keycloak"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5280/"
      },
      "protocolMappers": [
        {
          "name": "hrms-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hrms-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "hrms-dev-cli",
      "name": "LOCAL DEV ONLY - password grant for curl/PowerShell testing. Never enable in production.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "hrms-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hrms-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@acme.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "attributes": { "tenant_id": ["acme"] },
      "credentials": [{ "type": "password", "value": "Dev-Only-Pass-2026!", "temporary": false }],
      "realmRoles": ["HR_ADMIN", "EMPLOYEE"]
    },
    {
      "username": "mark",
      "enabled": true,
      "email": "mark@acme.test",
      "emailVerified": true,
      "firstName": "Mark",
      "lastName": "Manager",
      "attributes": { "tenant_id": ["acme"] },
      "credentials": [{ "type": "password", "value": "Dev-Only-Pass-2026!", "temporary": false }],
      "realmRoles": ["MANAGER", "EMPLOYEE"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@acme.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Builder",
      "attributes": { "tenant_id": ["acme"] },
      "credentials": [{ "type": "password", "value": "Dev-Only-Pass-2026!", "temporary": false }],
      "realmRoles": ["EMPLOYEE"]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@globex.test",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Globex",
      "attributes": { "tenant_id": ["globex"] },
      "credentials": [{ "type": "password", "value": "Dev-Only-Pass-2026!", "temporary": false }],
      "realmRoles": ["HR_ADMIN", "EMPLOYEE"]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ADMIN_EDIT\"}"
          ]
        }
      }
    ]
  }
}
